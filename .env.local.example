# ==== Shopify Admin API ====
# Domain store, dạng: hussio.myshopify.com  (KHÔNG có https://)
SHOPIFY_STORE_DOMAIN=hussio.myshopify.com

# Admin API access token của Custom App (bắt đầu bằng shpat_...)
# Lấy tại: Shopify Admin > Settings > Apps and sales channels > Develop apps
# > Create app > Configure Admin API scopes: write_discounts, read_discounts
# > Install app > Reveal token
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phiên bản Admin API (giữ mặc định nếu không rõ)
SHOPIFY_API_VERSION=2025-01

# Domain công khai để tạo link áp mã (dùng cho cột "Link áp mã" khi export)
# Ví dụ: hussio.com  -> link sẽ là https://hussio.com/discount/<mã>
SHOPIFY_PUBLIC_DOMAIN=hussio.com

# ==== Bảo mật tool nội bộ (đăng nhập đơn giản) ====
# Mật khẩu để vào dashboard. Đổi thành chuỗi khó đoán.
APP_PASSWORD=hussio2026

# ==== (Tuỳ chọn) MySQL cho "gán khách" — cần khi deploy Vercel ====
# Nếu KHÔNG khai báo, app tự lưu vào data/assignments.json (chỉ hợp dev/local,
# KHÔNG chạy trên Vercel vì fs read-only). Bảng tự tạo lần chạy đầu.
#
# Cách 1: một chuỗi kết nối
# DATABASE_URL=mysql://user:password@host:3306/dbname
#
# Cách 2: khai báo rời
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=hussio_voucher
